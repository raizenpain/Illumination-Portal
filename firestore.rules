rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dungeon Master admins — keep this list in sync with admins.js
    // (Firestore rules can't import that file directly).
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'jornie.hinay@hcdc.edu.ph',
               'iris.miranda@hcdc.edu.ph'
             ];
    }

    // A student's teacherEmail/section aren't in their auth token, so
    // class-scoped collections (classChatMessages) need a cross-
    // document lookup to know "which class is the CALLER actually in"
    // rather than trusting whatever the request claims. Bound in one
    // `let` so it's a single read per rule evaluation, not one per
    // field compared. msgData is either resource.data (read/update,
    // the doc as it already exists) or request.resource.data (create,
    // the doc being written).
    function isInCallerClass(msgData) {
      let caller = get(/databases/$(database)/documents/students/$(request.auth.token.email)).data;
      return caller.teacherEmail == msgData.teacherEmail &&
             caller.section == msgData.section;
    }

    // Every field a student's own record can legitimately hold, across
    // every write path in the app (enrollment, teacher pick, puzzle
    // pieces, puzzle-gate unlocks, season tickets/achievements/node
    // progress, reflections, mistake tracking, crafting, trader,
    // leaderboard reward timestamps, certificate codes). This doesn't
    // stop a student from setting a legitimate field to a bogus VALUE
    // via devtools (that needs server-side validation, e.g. Cloud
    // Functions, to fully close) — it stops them injecting an entirely
    // made-up field name. Keep this in sync whenever a new field is
    // introduced, or that feature's write will start silently failing.
    function studentSelfFields() {
      return [
        'name', 'email', 'section', 'studentId', 'createdAt',
        'teacherName', 'teacherEmail',
        'totalPieces', 'puzzle1', 'puzzle1Completed',
        'puzzle2', 'puzzle2Completed', 'puzzle3', 'puzzle3Completed',
        'puzzle2Unlocked', 'puzzle3Unlocked',
        'achievements', 'completedNodes', 'nodeSubmissions',
        'tickets', 'unlockTokens', 'mistakeCount',
        'chosenLegendaryChain', 'ownedArtifacts',
        'lastVisitRewardDate', 'lastTop5RewardDate',
        'puzzle3Reflection', 'puzzle3ReflectionSubmittedAt', 'midtermUnlocked',
        'semifinalReflection', 'semifinalUnlocked', 'semifinalReflectionSubmittedAt',
        'finalReflection', 'finalUnlocked', 'finalReflectionSubmittedAt',
        'apostleReflection', 'apostleUnlocked', 'apostleReflectionSubmittedAt',
        'verificationCode', 'midtermVerificationCode',
        'semifinalVerificationCode', 'finalVerificationCode',
        'hasSeenDashboardTour'
      ];
    }

    // Students collection — doc ID is the student's email
    match /students/{studentId} {
      // A student can read their own record, and so can an admin (for the progress table)
      allow read: if request.auth != null &&
                     (request.auth.token.email == studentId || isAdmin());

      // A student can create their own record — only on enrollment,
      // and only using real field names (see studentSelfFields above).
      allow create: if request.auth != null &&
                       request.auth.token.email == studentId &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.keys().hasOnly(studentSelfFields());

      // A student can freely update their OWN record's real fields
      // (progress, tickets, artifacts, etc.) — never anyone else's,
      // and never a made-up field name. Checks only the fields THIS
      // write actually touches (diff/affectedKeys), not the whole
      // resulting document — a stray legacy field left over on some
      // student's doc from an earlier version of the app (nothing
      // writes it anymore, but it's still sitting there) must never
      // block that student from making any further progress. Admins
      // can also update, but only the specific fields Gift Tickets
      // and Re-assign Class actually touch — never progress,
      // achievements, or artifacts.
      allow update: if request.auth != null &&
                       ((request.auth.token.email == studentId &&
                         request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(studentSelfFields())) ||
                        (isAdmin() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['teacherEmail', 'teacherName', 'section', 'tickets'])));

      // Admins can delete a student record (e.g. a student who enrolled
      // under the wrong teacher/class offering) — but not edit progress
      allow delete: if isAdmin();
    }

    // Leaderboard collection — doc ID is the student's email. Public,
    // slim summary (name, rank, star count) so every student can see
    // community-wide rankings without gaining read access to the full
    // students collection (email, section, teacher, tickets, etc. stay
    // private there). progressPercent is stored too, purely to sort by
    // pace — it's never rendered, only rank + stars are shown.
    match /leaderboard/{studentId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null &&
                      request.auth.token.email == studentId &&
                      request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                      request.resource.data.keys().hasOnly(['name', 'progressPercent', 'createdAt', 'rank', 'starsEarned', 'mistakeCount']);

      // Admins can remove a leaderboard entry (e.g. after deleting the
      // matching student record) so it doesn't linger in the public
      // Top 5 forever, frozen at its last-known pace.
      allow delete: if isAdmin();
    }

    // Settings collection — puzzle piece release status
    match /settings/{settingId} {
      // Any signed-in student can check which pieces are released
      allow read: if request.auth != null;

      // Only admins can release pieces
      allow write: if isAdmin();
    }

    // Activities collection — public, name-only community feed
    match /activities/{activityId} {
      // Any signed-in student can read the live feed
      allow read: if request.auth != null;

      // A student may only log activity about themselves (userId must
      // be their own auth email — that's the real attribution), with
      // the exact shape the feed expects and no arbitrary extra fields.
      // studentName is a display string only, deliberately NOT cross-
      // checked against students/{id}.name: that field is frozen at
      // enrollment while a student's live Google display name (what
      // every logActivity() call actually passes) can change over the
      // semester, so an exact-match rule would eventually reject
      // legitimate posts, not just spoofed ones.
      allow create: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.userId == request.auth.token.email &&
                       request.resource.data.keys().hasOnly(['userId', 'studentName', 'type', 'title', 'icon', 'timestamp']) &&
                       request.resource.data.type in ['piece', 'achievement', 'puzzle', 'rank', 'challenge', 'season', 'artifact'];

      // Immutable log — no edits or deletes
      allow update, delete: if false;
    }

    // Per-class chat — private to students who share the same
    // (teacherEmail, section) pair, plus admins. Unlike activities
    // (intentionally public site-wide), this is NOT a public feed.
    match /classChatMessages/{messageId} {
      // Only the sender's own classmates (by their OWN current
      // teacherEmail/section on file, not anything the client claims)
      // or an admin can read a message.
      allow read: if request.auth != null &&
                     (isAdmin() || isInCallerClass(resource.data));

      // A student can only post as themselves, into their OWN actual
      // class. An admin has no students/{email} doc to check against
      // (isInCallerClass would just error on the missing get()), so
      // they're allowed to post into ANY class instead -- consistent
      // with them already being fully trusted elsewhere in this app,
      // and how a teacher joins their own class's chat from the
      // roster view. Message text itself is trusted here (already run
      // through contentFilter.js client-side before this call) --
      // this rule guards the shape/attribution, not the content.
      allow create: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.senderEmail == request.auth.token.email &&
                       request.resource.data.keys().hasOnly(
                         ['senderEmail', 'senderName', 'teacherEmail', 'section', 'text', 'timestamp', 'reported']
                       ) &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 500 &&
                       request.resource.data.reported == false &&
                       (isAdmin() || isInCallerClass(request.resource.data));

      // Report-only: the one allowed change after a message exists.
      // Anyone in the same class (or admin) can flip reported to true
      // -- never false, never touching anything else. This can never
      // make a message disappear, only flag it for the teacher.
      allow update: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported']) &&
                       request.resource.data.reported == true &&
                       (isAdmin() || isInCallerClass(resource.data));

      // Only a teacher/admin can remove a message, and only after
      // reviewing it in the class chat log -- students can never
      // delete, matching the "nothing vanishes before a teacher sees
      // it" policy.
      allow delete: if isAdmin();
    }

    // Everything else — denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
