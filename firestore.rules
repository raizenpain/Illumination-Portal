rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dungeon Master admins — keep this list in sync with admins.js
    // (Firestore rules can't import that file directly).
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'jornie.hinay@hcdc.edu.ph',
               'iris.miranda@hcdc.edu.ph'
             ];
    }

    // The Prelim Season locks for good at 2026-10-10 00:00 Philippine
    // time (= 1791561600000 ms, mirrored from PRELIM_LOCKS_AT in
    // prelimDeadline.js). From then on, a student can only write their
    // own record if midtermUnlocked was ALREADY true -- which also means
    // midtermUnlocked can never be flipped false -> true after the lock,
    // by the app or by devtools. No new student records after the lock.
    function prelimLockPassed() {
      return request.time >= timestamp.value(1791561600000);
    }

    // A student's teacherEmail/section aren't in their auth token, so
    // class-scoped collections (classChatMessages) need a cross-
    // document lookup to know "which class is the CALLER actually in"
    // rather than trusting whatever the request claims. Bound in one
    // `let` so it's a single read per rule evaluation, not one per
    // field compared. msgData is either resource.data (read/update,
    // the doc as it already exists) or request.resource.data (create,
    // the doc being written).
    function isInCallerClass(msgData) {
      let caller = get(/databases/$(database)/documents/students/$(request.auth.token.email)).data;
      return caller.teacherEmail == msgData.teacherEmail &&
             caller.section == msgData.section;
    }

    // Every field a student's own record can legitimately hold, across
    // every write path in the app (enrollment, teacher pick, puzzle
    // pieces, puzzle-gate unlocks, season tickets/achievements/node
    // progress, reflections, mistake tracking, crafting, trader,
    // leaderboard reward timestamps, certificate codes). This doesn't
    // stop a student from setting a legitimate field to a bogus VALUE
    // via devtools (that needs server-side validation, e.g. Cloud
    // Functions, to fully close) — it stops them injecting an entirely
    // made-up field name. Keep this in sync whenever a new field is
    // introduced, or that feature's write will start silently failing.
    function studentSelfFields() {
      return [
        'name', 'email', 'section', 'studentId', 'createdAt',
        'teacherName', 'teacherEmail',
        'totalPieces', 'puzzle1', 'puzzle1Completed',
        'puzzle2', 'puzzle2Completed', 'puzzle3', 'puzzle3Completed',
        'puzzle2Unlocked', 'puzzle3Unlocked',
        'achievements', 'completedNodes', 'nodeSubmissions',
        'tickets', 'unlockTokens', 'mistakeCount',
        'chosenLegendaryChain', 'ownedArtifacts',
        'lastVisitRewardDate', 'lastTop5RewardDate',
        'puzzle3Reflection', 'puzzle3ReflectionSubmittedAt', 'midtermUnlocked',
        'semifinalReflection', 'semifinalUnlocked', 'semifinalReflectionSubmittedAt',
        'finalReflection', 'finalUnlocked', 'finalReflectionSubmittedAt',
        'apostleReflection', 'apostleUnlocked', 'apostleReflectionSubmittedAt',
        'verificationCode', 'midtermVerificationCode',
        'semifinalVerificationCode', 'finalVerificationCode',
        'hasSeenDashboardTour', 'avatarImage',
        'sideQuests', 'vaultGames', 'seenGameGuides',
        'vaultCapstoneGranted', 'vaultCapstoneKeyUsed', 'discipleBonusGranted',
        'hasSeenPrelimReminder',
        'hasSeenFiesta75Announcement', 'legendaryCountdownStartedAt', 'legendaryKeyUsedAt',
        'journeyCompleteSeen', 'legendaryForgeSeen', 'legendaryForgeStartedAt', 'legendaryForgeChain',
        'finalGiftGranted',
        'puzzle2VerificationCode', 'puzzle3VerificationCode', 'certificateDates',
        'prelimVerificationCode', 'vaultVerificationCode',
        'artifactRefundNotice', 'revisionRequests'
      ];
    }

    // An admin correcting a *Completed flag that's out of sync with
    // actual pieces collected (teacher.js's roster "Fix Flagged
    // Completion" action, for exactly the kind of devtools tampering
    // rank.js's isPuzzleComplete()/isPrelimSeasonDone() now defend
    // against on the read side) may only ever clear a flag to false,
    // never set one true -- a real completion only ever happens through
    // app.js's own piece-count-gated write. Checks each completion
    // field independently so fixing just one puzzle doesn't require the
    // others in the same payload.
    function isValidAdminCompletionFix() {
      let touched = request.resource.data.diff(resource.data).affectedKeys();
      return (!('puzzle1Completed' in touched) || request.resource.data.puzzle1Completed == false) &&
             (!('puzzle2Completed' in touched) || request.resource.data.puzzle2Completed == false) &&
             (!('puzzle3Completed' in touched) || request.resource.data.puzzle3Completed == false);
    }

    // Students collection — doc ID is the student's email
    match /students/{studentId} {
      // A student can read their own record, and so can an admin (for the progress table)
      allow read: if request.auth != null &&
                     (request.auth.token.email == studentId || isAdmin());

      // A student can create their own record — only on enrollment,
      // and only using real field names (see studentSelfFields above).
      allow create: if request.auth != null &&
                       request.auth.token.email == studentId &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.keys().hasOnly(studentSelfFields()) &&
                       !prelimLockPassed();

      // A student can freely update their OWN record's real fields
      // (progress, tickets, artifacts, etc.) — never anyone else's,
      // and never a made-up field name. Checks only the fields THIS
      // write actually touches (diff/affectedKeys), not the whole
      // resulting document — a stray legacy field left over on some
      // student's doc from an earlier version of the app (nothing
      // writes it anymore, but it's still sitting there) must never
      // block that student from making any further progress. Admins
      // can also update, but only the specific fields Gift Tickets,
      // Re-assign Class, and the roster's Fix
      // Flagged Completion action actually touch — never real progress,
      // achievements, or artifacts.
      //
      // The *Completed fields being legal key names alone can't stop an
      // admin write from setting one true, so isValidAdminCompletionFix()
      // is what actually restricts it to clearing, not setting.
      allow update: if request.auth != null &&
                       ((request.auth.token.email == studentId &&
                         request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                         (!prelimLockPassed() || resource.data.get('midtermUnlocked', false) == true) &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(studentSelfFields())) ||
                        (isAdmin() &&
                         request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['teacherEmail', 'teacherName', 'section', 'tickets',
                                     'puzzle1Completed', 'puzzle2Completed', 'puzzle3Completed']) &&
                         isValidAdminCompletionFix()));

      // Admins can delete a student record (e.g. a student who enrolled
      // under the wrong teacher/class offering) — but not edit progress
      allow delete: if isAdmin();
    }

    // Leaderboard collection — doc ID is the student's email. Public,
    // slim summary (name, rank, star count) so every student can see
    // community-wide rankings without gaining read access to the full
    // students collection (email, section, teacher, tickets, etc. stay
    // private there). progressPercent is stored too, purely to sort by
    // pace — it's never rendered, only rank + stars are shown.
    match /leaderboard/{studentId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null &&
                      request.auth.token.email == studentId &&
                      request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                      request.resource.data.keys().hasOnly(['name', 'progressPercent', 'createdAt', 'rank', 'starsEarned', 'mistakeCount', 'rankScore']) &&
                      (!('rankScore' in request.resource.data) || request.resource.data.rankScore is number);

      // Admins can remove a leaderboard entry (e.g. after deleting the
      // matching student record) so it doesn't linger in the public
      // Top 5 forever, frozen at its last-known pace.
      allow delete: if isAdmin();
    }

    // Settings collection — puzzle piece release status
    match /settings/{settingId} {
      // Any signed-in student can check which pieces are released
      allow read: if request.auth != null;

      // Only admins can release pieces
      allow write: if isAdmin();
    }

    // Activities collection — public, name-only community feed
    match /activities/{activityId} {
      // Any signed-in student can read the live feed
      allow read: if request.auth != null;

      // A student may only log activity about themselves (userId must
      // be their own auth email — that's the real attribution), with
      // the exact shape the feed expects and no arbitrary extra fields.
      // studentName is a display string only, deliberately NOT cross-
      // checked against students/{id}.name: that field is frozen at
      // enrollment while a student's live Google display name (what
      // every logActivity() call actually passes) can change over the
      // semester, so an exact-match rule would eventually reject
      // legitimate posts, not just spoofed ones.
      allow create: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.userId == request.auth.token.email &&
                       request.resource.data.keys().hasOnly(['userId', 'studentName', 'type', 'title', 'icon', 'timestamp']) &&
                       request.resource.data.type in ['piece', 'achievement', 'puzzle', 'rank', 'challenge', 'season', 'artifact', 'sidequest', 'vaultgame'] &&
                       // The feed orders by timestamp, so it must be a real
                       // server time (serverTimestamp() resolves to
                       // request.time) -- a string or far-future value
                       // would blank or pin the whole school's feed for good.
                       request.resource.data.timestamp == request.time &&
                       request.resource.data.studentName is string && request.resource.data.studentName.size() <= 120 &&
                       request.resource.data.title is string && request.resource.data.title.size() <= 300 &&
                       request.resource.data.icon is string && request.resource.data.icon.size() <= 200;

      // Immutable log for everyone but admins -- no edits, but an admin can
      // remove a bad entry without going through the Firebase console.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Per-class chat — private to students who share the same
    // (teacherEmail, section) pair, plus admins. Unlike activities
    // (intentionally public site-wide), this is NOT a public feed.
    match /classChatMessages/{messageId} {
      // Only the sender's own classmates (by their OWN current
      // teacherEmail/section on file, not anything the client claims)
      // or an admin can read a message.
      allow read: if request.auth != null &&
                     (isAdmin() || isInCallerClass(resource.data));

      // A student can only post as themselves, into their OWN actual
      // class. An admin has no students/{email} doc to check against
      // (isInCallerClass would just error on the missing get()), so
      // they're allowed to post into ANY class instead -- consistent
      // with them already being fully trusted elsewhere in this app,
      // and how a teacher joins their own class's chat from the
      // roster view. Message text itself is trusted here (already run
      // through contentFilter.js client-side before this call) --
      // this rule guards the shape/attribution, not the content.
      // 'type' is optional and, when present, may only be 'greeting' --
      // the one system-styled message kind (see dailyGreeting.js),
      // still attributed to the real posting account above, just
      // rendered differently client-side.
      // 'imageId' (admin-only image posts, see chatImages.js) must be
      // this message's own id and point at an existing classChatImages
      // doc; with an image the caption (text) may be empty.
      allow create: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.senderEmail == request.auth.token.email &&
                       request.resource.data.keys().hasOnly(
                         ['senderEmail', 'senderName', 'teacherEmail', 'section', 'text', 'timestamp', 'reported', 'type', 'imageId']
                       ) &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() <= 500 &&
                       (request.resource.data.text.size() > 0 || 'imageId' in request.resource.data) &&
                       (!('imageId' in request.resource.data) ||
                        (isAdmin() &&
                         request.resource.data.imageId == messageId &&
                         exists(/databases/$(database)/documents/classChatImages/$(messageId)))) &&
                       request.resource.data.reported == false &&
                       (!('type' in request.resource.data) || request.resource.data.type == 'greeting') &&
                       (isAdmin() || isInCallerClass(request.resource.data));

      // Report-only: the one allowed change after a message exists.
      // Anyone in the same class (or admin) can flip reported to true
      // -- never false, never touching anything else. This can never
      // make a message disappear, only flag it for the teacher.
      allow update: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported']) &&
                       request.resource.data.reported == true &&
                       (isAdmin() || isInCallerClass(resource.data));

      // Only a teacher/admin can remove a message, and only after
      // reviewing it in the class chat log -- students can never
      // delete, matching the "nothing vanishes before a teacher sees
      // it" policy.
      allow delete: if isAdmin();
    }

    // The image bytes for an admin image post, kept apart from
    // classChatMessages so the always-on badge listener never downloads
    // them (see chatImages.js). Same id as its message. Readable by the
    // same people as the message; only admins can create or delete.
    // The data is a compressed JPEG data URL, capped well under
    // Firestore's 1 MiB document limit.
    match /classChatImages/{imageId} {
      allow read: if request.auth != null &&
                     (isAdmin() || isInCallerClass(resource.data));

      allow create: if isAdmin() &&
                       request.resource.data.keys().hasOnly(
                         ['senderEmail', 'teacherEmail', 'section', 'data', 'timestamp']
                       ) &&
                       request.resource.data.senderEmail == request.auth.token.email &&
                       request.resource.data.teacherEmail is string &&
                       request.resource.data.section is string &&
                       request.resource.data.data is string &&
                       request.resource.data.data.size() <= 600000 &&
                       request.resource.data.data[0:23] == 'data:image/jpeg;base64,';

      allow delete: if isAdmin();
    }

    // Site-wide announcements data, e.g. the Midterm Roll of Honor
    // (midtermHonorRoll.js): one doc listing honored students' names,
    // ranks and stars. Any signed-in account can read it; only an admin
    // (whose roster page rebuilds it) can write it.
    match /announcements/{docId} {
      allow read: if request.auth != null;

      allow create, update: if isAdmin() &&
                               request.resource.data.keys().hasOnly(['students', 'updatedAt']) &&
                               request.resource.data.students is list &&
                               request.resource.data.students.size() <= 500;

      allow delete: if isAdmin();
    }

    // One tiny tracking doc per class room (id: `${teacherEmail}__${section}`),
    // holding only the date the daily greeting was last posted there --
    // see dailyGreeting.js. Whoever opens that room's chat first each
    // day both reads and writes this inside a transaction, so it needs
    // the same class-membership check as the messages themselves.
    match /classChatGreetings/{roomId} {
      // resource is null until the room's first greeting is written --
      // without the null check, isInCallerClass(resource.data) errors on
      // the missing doc, the transaction's tx.get is denied, and a student
      // can never be the one to create it.
      allow read: if request.auth != null &&
                     (resource == null || isAdmin() || isInCallerClass(resource.data));

      allow create: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.keys().hasOnly(['teacherEmail', 'section', 'lastDate']) &&
                       request.resource.data.lastDate is string &&
                       (isAdmin() || isInCallerClass(request.resource.data));

      allow update: if request.auth != null &&
                       request.auth.token.email.matches('.*@hcdc[.]edu[.]ph$') &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastDate']) &&
                       request.resource.data.lastDate is string &&
                       (isAdmin() || isInCallerClass(resource.data));
    }

    // Everything else — denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
